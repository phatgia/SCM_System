@model SCM_System.Models.ViewModels.ManagerReportViewModel
@{
    ViewData["Title"] = "Quản lý kinh doanh";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Báo cáo kinh doanh</h4>
        <p class="text-muted small mb-0">Thống kê doanh thu, chi phí và hiệu quả vận hành</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Loại báo cáo</label>
                    <select name="reportType" class="form-select form-select-sm shadow-sm">
                        <option value="summary" selected="@(Model.ReportType == "summary")">Tổng quan thu chi</option>
                        <option value="revenue" selected="@(Model.ReportType == "revenue")">Biểu đồ doanh thu</option>
                        <option value="purchase" selected="@(Model.ReportType == "purchase")">Biểu đồ nhập hàng</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control form-control-sm shadow-sm">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm"><i class="bi bi-filter me-1"></i>Xem báo cáo</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-primary bg-opacity-10 h-100"><div class="card-body"><p class="small text-primary fw-semibold mb-1">TỔNG DOANH THU</p><h3 class="fw-bold mb-0">@Model.CurrencySymbol@Model.TotalRevenue</h3></div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm bg-danger bg-opacity-10 h-100"><div class="card-body"><p class="small text-danger fw-semibold mb-1">CHI PHÍ NHẬP HÀNG</p><h3 class="fw-bold mb-0">@Model.CurrencySymbol@Model.TotalExpense</h3></div></div></div>
    <div class="col-md-2"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center"><p class="small text-muted fw-semibold mb-1">ĐƠN HOÀN THÀNH</p><h3 class="fw-bold mb-0">@Model.CompletedOrdersCount</h3></div></div></div>
    <div class="col-md-2"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center"><p class="small text-muted fw-semibold mb-1">TỶ LỆ GIAO HÀNG</p><h3 class="fw-bold mb-0 text-success">@Model.DeliverySuccessRate</h3></div></div></div>
    <div class="col-md-2"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center"><p class="small text-muted fw-semibold mb-1">TỶ LỆ ĐỔI TRẢ</p><h3 class="fw-bold mb-0 text-warning">@Model.ReturnRate</h3></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Biểu đồ biến động</h5>
                <span class="badge bg-light text-dark border fw-normal">Đơn vị: @Model.CurrencySymbol</span>
            </div>
            <div class="card-body px-4 pb-4">
                <div style="height: 400px; position: relative;">
                    <canvas id="mainChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Top sản phẩm bán chạy</h5>
            </div>
            <div class="card-body px-4">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="text-muted small">
                            <tr><th>SẢN PHẨM</th><th class="text-end">SL</th><th class="text-end">DOANH THU</th></tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var p in Model.TopProducts)
                            {
                                <tr>
                                    <td class="fw-bold">@p.ProductName</td>
                                    <td class="text-end">@p.TotalSold</td>
                                    <td class="text-end text-primary fw-bold">@p.Revenue.ToString("N0")@Model.CurrencySymbol</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Đơn hàng gần đây</h5>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small fw-bold">
                            <tr>
                                <th>MÃ ĐƠN</th>
                                <th>KHÁCH HÀNG</th>
                                <th class="text-end">TỔNG TIỀN</th>
                                <th>TRẠNG THÁI</th>
                                <th>NGÀY</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-bold">@order.OrderCode</td>
                                    <td>@order.CustomerName</td>
                                    <td class="text-end fw-bold">@order.TotalAmount.ToString("N0")@Model.CurrencySymbol</td>
                                    <td>
                                        @{
                                            var badgeClass = order.Status switch {
                                                "Hoàn thành" => "bg-success",
                                                "Đang giao hàng" => "bg-primary",
                                                "Đã hủy" => "bg-danger",
                                                _ => "bg-warning"
                                            };
                                        }
                                        <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") px-2 rounded-pill">@order.Status</span>
                                    </td>
                                    <td class="text-muted">@order.Date.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let myChart = null;
        function initChart() {
            const ctx = document.getElementById('mainChart');
            if(!ctx) return;

            const reportType = '@Model.ReportType';
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
            const revData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDataRevenue));
            const expData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDataExpense));
            const symbol = '@Model.CurrencySymbol';

            let datasets = [];
            if (reportType === 'summary') {
                datasets = [
                    { label: 'Doanh thu (Sales)', data: revData, borderColor: '#0d6efd', backgroundColor: 'rgba(13, 110, 253, 0.1)', borderWidth: 3, fill: true, tension: 0.4, yAxisID: 'y' },
                    { label: 'Chi phí (Purchases)', data: expData, borderColor: '#dc3545', backgroundColor: 'rgba(220, 53, 69, 0.1)', borderWidth: 3, fill: true, tension: 0.4, yAxisID: 'y1' }
                ];
            } else if (reportType === 'revenue') {
                datasets = [{ label: 'Doanh thu bán hàng', data: revData, borderColor: '#0d6efd', backgroundColor: 'rgba(13, 110, 253, 0.1)', borderWidth: 3, fill: true, tension: 0.4, yAxisID: 'y' }];
            } else {
                datasets = [{ label: 'Chi phí nhập hàng', data: expData, borderColor: '#dc3545', backgroundColor: 'rgba(220, 53, 69, 0.1)', borderWidth: 3, fill: true, tension: 0.4, yAxisID: 'y' }];
            }

            myChart = new Chart(ctx.getContext('2d'), {
                type: 'line',
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { tooltip: { callbacks: { label: function(context) { return (context.dataset.label ? context.dataset.label + ': ' : '') + symbol + context.parsed.y.toLocaleString('vi-VN'); } } } },
                    scales: { y: { beginAtZero: true }, y1: { display: (reportType === 'summary'), position: 'right', beginAtZero: true, grid: { drawOnChartArea: false } }, x: { grid: { display: false } } }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", initChart);
    </script>
}
