@{
    ViewData["Title"] = "Kết quả nhận hàng";
    Layout = null; // Trang độc lập, tối ưu cho điện thoại
    bool isSuccess = ViewBag.Success == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] — SCM System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #f0f4f8;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }
        .result-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.12);
            padding: 40px 32px;
            text-align: center;
            max-width: 420px;
            width: 92%;
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @@keyframes popIn {
            from { opacity: 0; transform: scale(0.8) translateY(20px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .icon-ring {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 2.8rem;
        }
        .success-ring {
            background: linear-gradient(135deg, #d1fae5, #a7f3d0);
            color: #059669;
            box-shadow: 0 4px 20px rgba(5, 150, 105, 0.25);
        }
        .error-ring {
            background: linear-gradient(135deg, #fee2e2, #fecaca);
            color: #dc2626;
            box-shadow: 0 4px 20px rgba(220, 38, 38, 0.25);
        }
        .detail-box {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 20px 0;
            text-align: left;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px dashed #e2e8f0;
        }
        .detail-row:last-child { border-bottom: none; }
        .detail-label { color: #64748b; font-size: 0.85rem; }
        .detail-value { font-weight: 600; font-size: 0.9rem; color: #1e293b; }
        .btn-home {
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            color: white;
            border: none;
            padding: 14px 32px;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            margin-top: 8px;
            width: 100%;
            transition: transform 0.15s;
        }
        .btn-home:hover { transform: translateY(-2px); color: white; }
        .scm-logo { font-size: 0.85rem; color: #94a3b8; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="result-card">
        @if (isSuccess)
        {
            <div class="icon-ring success-ring">
                <i class="bi bi-check-lg"></i>
            </div>
            <h4 class="fw-bold text-success mb-1">Nhận hàng thành công!</h4>
            <p class="text-muted small">Đơn hàng đã được bàn giao và cập nhật hệ thống</p>
        }
        else
        {
            <div class="icon-ring error-ring">
                <i class="bi bi-x-lg"></i>
            </div>
            <h4 class="fw-bold text-danger mb-1">Không thể nhận hàng</h4>
            <p class="text-muted small">Có lỗi xảy ra trong quá trình xử lý</p>
        }

        <div class="detail-box">
            @if (!string.IsNullOrEmpty(ViewBag.OrderCode as string))
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-receipt me-1"></i>Mã đơn</span>
                    <span class="detail-value text-primary">@ViewBag.OrderCode</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.CustomerName as string))
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-person me-1"></i>Khách hàng</span>
                    <span class="detail-value">@ViewBag.CustomerName</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.ShipperName as string))
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-truck me-1"></i>Shipper</span>
                    <span class="detail-value">@ViewBag.ShipperName</span>
                </div>
            }
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-clock me-1"></i>Thời gian</span>
                <span class="detail-value">@DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-info-circle me-1"></i>Kết quả</span>
                <span class="detail-value @(isSuccess ? "text-success" : "text-danger")">
                    @(ViewBag.Message ?? (isSuccess ? "Thành công" : "Thất bại"))
                </span>
            </div>
        </div>

        <a href="@Url.Action("Delivery", "Delivery")" class="btn-home">
            <i class="bi bi-arrow-left me-2"></i>Về trang Vận chuyển
        </a>

        <div class="scm-logo mt-3">
            <i class="bi bi-box-seam me-1"></i>SCM System — Quản lý chuỗi cung ứng
        </div>
    </div>
</body>
</html>
